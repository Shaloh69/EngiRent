# Compiled binaries — distribute via GitHub Releases, not git
*.apk
AI_SYSTEM_DOCUMENTATION.pdf

# Mermaid bundle cached for design/tools/render-diagrams.mjs (~3MB, re-fetchable)
design/tools/.cache/

# ML eval dataset: real kiosk/listing photos, never committed (the repo is public)
server/python_server/services/ml/eval/data/
# ML eval run outputs (per-pair scores; regenerated by eval/harness.py)
server/python_server/services/ml/eval/runs/
server/python_server/services/ml/.venv-eval/
server/python_server/services/ml/cache_v2/
# Face liveness (2026-10-15): real face frames are biometric data and the repo is public. Local only, never committed.
server/python_server/services/ml/tests/fixtures/faces/
# Face model weights (BiSeNet face parsing etc.): fetched by deploy/fetch_face_models.py, hash-checked, not committed.
server/python_server/services/ml/models_face/

# Playwright / emulator screenshots: may show faces, ID photos and student data (the repo is public).
.playwright-mcp/

# Thesis documents (real names, unpublished): never commit; the repo is public.
/EngiRent-Hub-*.docx
/EngiRent-Hub-*.pdf
