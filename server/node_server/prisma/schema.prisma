// EngiRent Hub Database Schema
// Prisma ORM configuration for MySQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model - Students who use the system
model User {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  studentId   String @unique
  firstName   String
  lastName    String
  phoneNumber String

  // Profile & identity (photos must be taken in-app, not uploaded)
  profileImage String? // Face photo path (local storage) — used by AI for identity verification
  faceEncoding Json? // 128-float face_recognition encoding, AES-256-GCM encrypted (see utils/crypto.ts)
  idImageUrl   String? // School ID card photo path (local storage)

  // Profile completion — true once face + ID photos have been submitted
  profileComplete Boolean @default(false)

  // Biometric consent — an explicit, separate affirmative capture at profile
  // setup (distinct from general terms-of-service acceptance), required
  // before faceEncoding/idImageUrl are written. Null means no biometric data
  // has ever been captured, or consent predates this field's introduction —
  // completeProfile() requires a fresh consent flag on every biometric
  // submission regardless.
  biometricConsentAt DateTime?

  // Parent/Guardian information
  parentName    String?
  parentContact String?

  // Payout destination — where this user's rental earnings and security-
  // deposit refunds go via PayMongo's Disbursements (Transfers V2) API.
  // Optional at signup; only required by the time a rental this user owns
  // actually completes (see index.ts's completeRental). Collected once,
  // typically during profile setup or when first listing an item.
  payoutProvider        String? // "instapay" | "pesonet" — the rail destination_account routes over
  payoutBic             String? // provider_code from PayMongo's receiving-institutions list — identifies the bank/e-wallet
  payoutInstitutionName String? // display name of the chosen bank/e-wallet, cached so the UI doesn't need to re-resolve it from payoutBic
  payoutAccountName     String? // recipient account holder name
  payoutAccountNumber   Json? // recipient account number — AES-256-GCM encrypted (utils/crypto.ts), same pattern as faceEncoding; genuine financial PII, not just a display value

  // Account status
  // isVerified stays the single gate the rest of the system reads ("is this
  // student cleared"). The fields below record HOW that gate was set, which
  // previously nothing did: an admin flipped the boolean and no trace of who,
  // when, or on what evidence survived. See mandate 2.11.
  isVerified Boolean @default(false)

  // Workflow state, distinct from the gate. A student who has submitted and
  // is waiting is not the same as one who never submitted, and neither is the
  // same as one who was rejected — the app showed all three as "Pending".
  verificationStatus String    @default("UNSUBMITTED") // UNSUBMITTED | PENDING | APPROVED | REJECTED
  verificationReason String? // enum-ish code when rejected, see ID_REJECT_REASONS
  verificationNote   String? // free-text the reviewer adds for the student
  verifiedById       String? // the admin who decided; no FK so deleting an admin never erases the record
  verifiedAt         DateTime?

  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?

  // Role
  role UserRole @default(STUDENT)

  // Security
  refreshToken String?   @db.Text
  lastLogin    DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  itemsOwned      Item[]         @relation("ItemOwner")
  rentalsAsRenter Rental[]       @relation("RentalRenter")
  rentalsAsOwner  Rental[]       @relation("RentalOwner")
  transactions    Transaction[]
  notifications   Notification[]
  reviews         Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewRecipient")
  feedback        Feedback[]

  @@index([email])
  @@index([studentId])
  @@map("users")
}

// Item model - Items available for rent
model Item {
  id      String @id @default(uuid())
  ownerId String

  // Item details
  title       String
  description String        @db.Text
  category    ItemCategory
  condition   ItemCondition

  // Pricing
  pricePerDay     Float
  pricePerWeek    Float?
  pricePerMonth   Float?
  securityDeposit Float

  // Images (JSON array of URLs)
  images Json // ["url1", "url2", "url3"]

  // ML Features (stored for faster verification)
  mlFeatures   Json? // Extracted features from ML service
  serialNumber String? // For items with serial numbers

  // Availability
  //
  // Three separate ideas, deliberately not collapsed into one flag:
  //   isAvailable — rental state, flipped by the system when a rental starts
  //                 and completes. Not the owner's to set.
  //   isListed    — the owner's intent: "show this in browse". Someone whose
  //                 calculator is lent to a friend for a month needs to hide
  //                 the listing without destroying it and its review history.
  //   isActive    — soft delete.
  //
  // Overloading isAvailable for both of the first two would make "an owner
  // hid this" and "someone is renting it right now" indistinguishable, and
  // the rental lifecycle would silently re-list an item the owner had taken
  // down the moment a rental completed.
  isAvailable Boolean @default(true)
  isListed    Boolean @default(true)
  isActive    Boolean @default(true)

  // Location
  campusLocation String? // UCLM Lapu-Lapu or Mandaue

  // Statistics
  totalRentals  Int   @default(0)
  averageRating Float @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner   User     @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rentals Rental[]
  reviews Review[]

  @@index([ownerId])
  @@index([category])
  @@index([isAvailable])
  // Browse filters on these three together on every request.
  @@index([isActive, isListed])
  @@map("items")
}

// Rental model - Rental transactions
model Rental {
  id       String @id @default(uuid())
  itemId   String
  renterId String
  ownerId  String

  // Rental period
  startDate        DateTime
  endDate          DateTime
  actualReturnDate DateTime?

  // Status tracking
  status RentalStatus @default(PENDING)

  // Pricing
  totalPrice      Float
  securityDeposit Float

  // Kiosk integration
  depositLockerId String?
  claimLockerId   String?
  returnLockerId  String?

  // Verification
  depositVerificationId String?             @unique
  verificationId        String?             @unique
  verificationScore     Float?
  verificationStatus    VerificationStatus?

  // Retry attempt counters (incremented on each RETRY/REJECTED decision)
  depositAttemptCount Int @default(0)
  returnAttemptCount  Int @default(0)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  depositedAt DateTime?
  claimedAt   DateTime?
  returnedAt  DateTime?
  completedAt DateTime?

  // Relations
  item                Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  renter              User          @relation("RentalRenter", fields: [renterId], references: [id])
  owner               User          @relation("RentalOwner", fields: [ownerId], references: [id])
  transactions        Transaction[]
  reviews             Review[]
  depositVerification Verification? @relation("DepositVerification", fields: [depositVerificationId], references: [id])
  verification        Verification? @relation("ReturnVerification", fields: [verificationId], references: [id])
  depositLocker       Locker?       @relation("DepositLocker", fields: [depositLockerId], references: [id])
  claimLocker         Locker?       @relation("ClaimLocker", fields: [claimLockerId], references: [id])
  returnLocker        Locker?       @relation("ReturnLocker", fields: [returnLockerId], references: [id])

  @@index([itemId])
  @@index([renterId])
  @@index([ownerId])
  @@index([status])
  // Serves the daily late-fee cron's `{status: ACTIVE, endDate: {lt: now}}`
  // scan (index.ts) — a single-column index on `status` alone still requires
  // a filtered scan across every ACTIVE rental to compare endDate.
  @@index([status, endDate])
  @@map("rentals")
}

// Transaction model - Payment records
model Transaction {
  id       String @id @default(uuid())
  rentalId String
  userId   String

  // Payment details
  type   TransactionType
  amount Float
  status TransactionStatus @default(PENDING)

  // PayMongo integration
  paymentReferenceNo   String? @unique
  paymentTransactionId String? @unique
  paymongoPaymentId    String? // PayMongo payment ID for refunds
  paymongoCheckoutId   String? @unique // Checkout session ID

  // Payment gateway response
  paymentMethod  String @default("PayMongo")
  paymentDetails Json? // Additional payment info

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  // Relations
  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([rentalId])
  @@index([userId])
  @@index([paymentReferenceNo])
  @@map("transactions")
}

// Verification model - AI verification logs
model Verification {
  id String @id @default(uuid())

  // Images
  originalImages Json // Array of original item image URLs
  kioskImages    Json // Array of kiosk capture image URLs

  // Verification results
  decision        VerificationDecision
  confidenceScore Float
  attemptNumber   Int                  @default(1)

  // Method scores (from ML service)
  traditionalScore  Float?
  siftScore         Float?
  deepLearningScore Float?
  ocrMatch          Boolean?
  ocrDetails        Json?

  // Status
  status      VerificationStatus @default(PENDING)
  reviewedBy  String? // Admin ID if manually reviewed
  reviewNotes String?            @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rental        Rental? @relation("ReturnVerification")
  depositRental Rental? @relation("DepositVerification")

  @@index([decision])
  @@index([status])
  @@map("verifications")
}

// Locker model - Physical locker units
model Locker {
  id String @id @default(uuid())

  // Locker identification
  lockerNumber String @unique
  kioskId      String

  // Physical properties
  size LockerSize @default(MEDIUM)

  // Status
  status        LockerStatus @default(AVAILABLE)
  isOperational Boolean      @default(true)

  // Current rental
  currentRentalId String?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  // Relations
  depositRentals Rental[] @relation("DepositLocker")
  claimRentals   Rental[] @relation("ClaimLocker")
  returnRentals  Rental[] @relation("ReturnLocker")

  @@index([kioskId])
  @@index([status])
  @@map("lockers")
}

// KioskConfig model - Per-kiosk timing and hardware configuration
model KioskConfig {
  id        String   @id @default(uuid())
  kioskId   String   @unique
  config    Json // Shape mirrors kiosk_config.json
  updatedBy String? // Admin userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kiosk_configs")
}

// Notification model - User notifications
model Notification {
  id     String @id @default(uuid())
  userId String

  // Notification content
  title   String
  message String           @db.Text
  type    NotificationType

  // Related entity
  relatedEntityId   String? // Rental ID, Item ID, etc.
  relatedEntityType String? // "rental", "item", "transaction"

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// Feedback model — checklist Stage 3. Before this there was no feedback,
// support or bug-report path on the server at all: a student who hit a
// problem had no route to the people running the system, and admins running
// a deployment had no signal except rentals silently failing (mandate §2.9.3).
model Feedback {
  id     String @id @default(uuid())
  userId String

  category FeedbackCategory
  body     String           @db.Text

  // Private, same tier as a face/ID photo — never served by a direct route,
  // only through signedMediaUrl() (see storageService.feedbackScreenshotPath).
  // A screenshot can incidentally contain anything on the student's screen.
  screenshotPath String?

  // Automatically attached context — a report with none of this is close to
  // useless: "the locker didn't open" means nothing without knowing which
  // locker, when, and what build the student was running.
  appVersion String
  device     String?
  screen     String?
  rentalId   String?
  kioskId    String?
  // Snapshot of the kiosk's recent event log at submission time, only for
  // kiosk-problem reports with a kioskId — see utils/kioskEventLog.ts. The
  // events themselves are never persisted anywhere else (pure pub/sub), so
  // without this a "the locker didn't open" report would have nothing to
  // check against once the moment had passed.
  kioskEventSnapshot Json?

  status FeedbackStatus @default(NEW)

  // Triage — no FK on resolvedById so deleting an admin never erases the
  // record, same reasoning as User.verifiedById.
  adminNote    String?   @db.Text
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("feedback")
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  KIOSK_PROBLEM
  PAYMENT_PROBLEM
  OTHER
}

enum FeedbackStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

// Review model - User reviews
model Review {
  id          String  @id @default(uuid())
  itemId      String
  rentalId    String? // Link review to the rental that enabled it
  authorId    String
  recipientId String

  // Review content
  rating  Int // 1-5 stars
  comment String? @db.Text

  // Type
  reviewType ReviewType // ITEM or USER

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  rental    Rental? @relation(fields: [rentalId], references: [id])
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  recipient User    @relation("ReviewRecipient", fields: [recipientId], references: [id])

  @@unique([rentalId, authorId, reviewType]) // one review per role per rental
  @@index([itemId])
  @@index([authorId])
  @@index([recipientId])
  @@map("reviews")
}

// Enums
enum UserRole {
  STUDENT
  ADMIN
}

enum ItemCategory {
  SCHOOL_ATTIRE
  ACADEMIC_TOOLS
  ELECTRONICS
  DEVELOPMENT_KITS
  MEASUREMENT_TOOLS
  AUDIO_VISUAL
  SPORTS_EQUIPMENT
  OTHER
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  ACCEPTABLE
}

// AWAITING_CLAIM and AWAITING_RETURN were removed (2026-08-06) — neither was
// ever assigned by any code path. DEPOSITED already represents "awaiting
// claim" (there's no real gap between those two ideas); the return flow
// stays ACTIVE for the (brief) window between the renter physically
// returning the item and the AI verification resolving it to VERIFICATION/
// DISPUTED — introducing a real intermediate state there would require
// updating three separate status guards (kioskController.returnItem,
// index.ts's kiosk:images and kiosk:face return-flow branches) with real
// regression risk for a correctness-cleanup pass; simply removing the two
// enum values that were never live schema was the lower-risk fix.
enum RentalStatus {
  PENDING
  AWAITING_DEPOSIT
  DEPOSITED
  ACTIVE
  VERIFICATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TransactionType {
  RENTAL_PAYMENT
  SECURITY_DEPOSIT
  DEPOSIT_REFUND
  LATE_FEE
  DAMAGE_FEE
  // The real Disbursement Transfer paying the item owner their rental
  // earnings at completion — distinct from RENTAL_PAYMENT, which is the
  // renter's original charge into the platform's own PayMongo wallet, not
  // money reaching the owner. See rentalSettlementService.ts.
  OWNER_PAYOUT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum VerificationDecision {
  APPROVED
  PENDING
  RETRY
  REJECTED
}

enum VerificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  MANUAL_REVIEW
  APPROVED
  REJECTED
}

enum LockerSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum LockerStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum NotificationType {
  BOOKING_CONFIRMED
  DEPOSIT_REMINDER
  ITEM_READY_FOR_CLAIM
  CLAIM_REMINDER
  RENTAL_STARTED
  RETURN_REMINDER
  RETURN_OVERDUE
  VERIFICATION_SUCCESS
  VERIFICATION_FAILED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REVIEW_REQUEST
  SYSTEM_ANNOUNCEMENT
  // Sent when an admin resolves a feedback report — closing the loop is the
  // whole point of Stage 3; a triage queue nobody outside admin can see the
  // outcome of is still a one-way write as far as the reporting student
  // knows, notification or not.
  FEEDBACK_UPDATE
}

enum ReviewType {
  ITEM
  USER
}
