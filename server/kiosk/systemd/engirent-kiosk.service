[Unit]
Description=EngiRent Kiosk Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/engirent/server/kiosk
EnvironmentFile=/home/pi/engirent/server/kiosk/.env
ExecStart=/home/pi/engirent/server/kiosk/venv/bin/python main.py
# always, not on-failure: a clean exit(0) or a plain SIGTERM is not a "failure" to
# systemd, so on-failure could leave an unattended bank dark. Startup drives no
# hardware, so an automatic restart is safe. Applied on the Pi 2026-09-24.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=engirent-kiosk

# Allow GPIO access
SupplementaryGroups=gpio dialout video

[Install]
WantedBy=multi-user.target
