# Kiosk Identity
KIOSK_ID=kiosk-1

# Node.js Backend — points at the self-hosted PC's Tailscale address once
# Phase 0.5's hosting migration is live (e.g. http://desktop-gklhcri:5000);
# https://engirent-api.onrender.com is the pre-migration value, kept here
# only as a fallback reference.
SERVER_URL=http://desktop-gklhcri:5000
# For local dev on the same LAN: SERVER_URL=http://192.168.1.100:5000

# Shared secret proving this Pi is a genuine kiosk on the Socket.io handshake.
# MUST exactly match KIOSK_SHARED_SECRET on the backend. Use a long random value
# (e.g. `openssl rand -hex 32`). If empty, the backend refuses all kiosk events.
KIOSK_SHARED_SECRET=change-me-to-a-long-random-shared-secret

# Image uploads now go through the Node backend (POST /kiosk/upload,
# authenticated via KIOSK_SHARED_SECRET above) — Supabase is no longer used;
# see services/image_uploader.py.

# ML Service (for face verification) — same PC-hosting note as SERVER_URL above.
ML_SERVICE_URL=http://desktop-gklhcri:8001
# For local dev on the same LAN: ML_SERVICE_URL=http://192.168.1.100:8001
# Sent as X-API-Key on the /verify-face call. MUST match ML_API_KEY on the ML
# service (the same value configured as ML_SERVICE_API_KEY on the Node backend).
ML_SERVICE_API_KEY=change-me-to-a-long-random-shared-secret

# Local UI Server
UI_PORT=8080

# WiFi Provisioning AP
AP_SSID=EngiRent-Kiosk-Setup
AP_PASSWORD=engirent2026
AP_IP=192.168.4.1

# GPIO relay type: active_low (most relay modules) or active_high
RELAY_ACTIVE_LEVEL=active_low

# Debug mode (set True to simulate GPIO without hardware)
MOCK_GPIO=False
MOCK_CAMERA=False
